# Public OAuth client IDs only. Do not put passwords, private keys, or service-account credentials here.
# Required for Android Google sign-in; use the Web application OAuth client ID, not the Android client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional iOS Google sign-in configuration. The URL scheme is the reversed iOS client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
